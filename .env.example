# All values are SERVER-ONLY (no NEXT_PUBLIC_ — the browser never sees them).

# airv2 control-plane base URL, e.g. https://air.wzrd.tech
CONTROL_PLANE_URL=

# Bearer key checked by adminAuthorized() on the airv2 admin endpoints.
ADMIN_API_KEY=

# Password for the dashboard UI gate (/login). Deployment configuration,
# never source code.
DASHBOARD_PASSWORD=

# Optional: separate HMAC key for the session cookie (defaults to
# DASHBOARD_PASSWORD when unset).
SESSION_SECRET=

# Optional: W&B Weave mirror for exported trace receipts (dormant when unset).
WANDB_API_KEY=
WANDB_PROJECT=
